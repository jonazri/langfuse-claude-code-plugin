{
  "name": "langfuse-claude-code-plugin",
  "version": "0.3.0",
  "description": "Langfuse observability plugin for tracing Claude Code conversations",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && pnpm bundle",
    "bundle": "node esbuild.config.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langfuse/client": "5.10.1",
    "@langfuse/otel": "5.10.1",
    "@langfuse/tracing": "5.10.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/otlp-transformer": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.7",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}